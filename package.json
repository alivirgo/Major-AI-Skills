    "type": "git",
    "url": "git+https://github.com/alivirgo/Major-AI-Skills.git"
  },
  "bin": {
    "major-ai-skills": "tools/bin/install.js"
  },
  "main": "skills_index.json",
  "scripts": {
    "index": "node tools/scripts/generate_index.js",
    "catalog": "node tools/scripts/generate_index.js",
    "validate": "node tools/scripts/validate_skills.js",
    "index:check": "node tools/scripts/generate_index.js --check",
    "marketplaces": "node tools/scripts/generate_marketplaces.js",
    "marketplaces:check": "node tools/scripts/generate_marketplaces.js --check",
    "test": "node --test tools/tests/*.test.js",
    "build": "npm run index",
    "downloads:graph": "node tools/scripts/update_download_graph.js",
    "adoption:snapshot": "node tools/scripts/adoption_snapshot.js",
    "prepublishOnly": "npm run validate && npm run index && npm run marketplaces",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "skills",
    "skills.sh.json",
    "skills_index.json",
    "data/skills_index.json",
    "data/bundles.json",
    "assets/spotlight-checkout.png",
