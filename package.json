{
  "name": "major-ai-skills",
  "version": "2.3.0",
  "description": "Installable agentic skills / AI agent skills (SKILL.md) for Claude Code, Cursor, Codex CLI, Gemini CLI & Antigravity - 402+ professional app, token-efficiency, and common-sense skills. SEO/GEO ready.",
  "license": "MIT",
  "author": {
    "name": "Ali Virgo",
    "url": "https://github.com/alivirgo"
  },
  "homepage": "https://alivirgo.github.io/Major-AI-Skills/",
  "bugs": {
    "url": "https://github.com/alivirgo/Major-AI-Skills/issues"
  },
